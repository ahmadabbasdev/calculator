# Canonical site origin (no trailing slash). Required for production builds.
# Used for metadataBase, canonical/OG URLs, sitemap, robots, JSON-LD, and /llms.txt.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID (public; appears in page source). Optional in local dev.
# Loaded only after analytics consent on the canonical host.
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher client ID (public; appears in page source). Optional in local dev.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Trust-page owner fields (About / Contact / Privacy).
# Optional — if unset, src/lib/site-owner.ts uses the same defaults shown here.
NEXT_PUBLIC_OWNER_NAME=Ahmad
NEXT_PUBLIC_OWNER_LOCATION=Pakistan
NEXT_PUBLIC_WHY_I_BUILT_THIS=I built CalcDaily so people can run common date, finance, health, and math calculations in the browser without creating an account. Each tool is checked with automated tests, and sourced schedules (like state income tax) are verified before they go live.
NEXT_PUBLIC_OWNER_PHOTO=
NEXT_PUBLIC_CONTACT_EMAIL=asam4055155@gmail.com
NEXT_PUBLIC_RESPONSE_TIME=within 2 business days
